{# secrets/trading-bot.env — Vault secrets + cleartext bootstrap ENV #}
{# Values are rendered with `=` form for Compose env_file.              #}
{# Bootstrap values are skipped when the key already exists in Vault.   #}
{# Always stringify so YAML booleans (e.g. accidental bare `off`) do   #}
{# not leak as False/True into the container environment.               #}
APEXVOID_CONFIG_FILE=/config/trading-bot.yml
{% for key, value in (apexvoid_trading_bot_secrets | dictsort) %}
{{ key }}={{ value | string }}
{% endfor %}
{% for key, value in (apexvoid_trading_bot_bootstrap_env | dictsort) %}
{% if key not in apexvoid_trading_bot_secrets %}
{{ key }}={{ value | string }}
{% endif %}
{% endfor %}
